{
  "name": "context-hub",
  "version": "1.0.0",
  "description": "Context Hub API — turn videos into searchable knowledge",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migration:run": "NODE_OPTIONS='--import tsx' typeorm migration:run -d src/database/data-source.ts",
    "migration:revert": "NODE_OPTIONS='--import tsx' typeorm migration:revert -d src/database/data-source.ts",
    "migration:show": "NODE_OPTIONS='--import tsx' typeorm migration:show -d src/database/data-source.ts",
    "db:ping": "tsx src/database/check-connectivity.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhonathamatias/context-hub.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jhonathamatias/context-hub/issues"
  },
  "homepage": "https://github.com/jhonathamatias/context-hub#readme",
  "dependencies": {
    "fastify": "^5.12.3",
    "ioredis": "^5.11.1",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "typedi": "^0.10.0",
    "typeorm": "^1.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
