{
  "name": "context-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Context Hub monorepo — API + web MVP",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "pnpm exec tsx scripts/dev.mts",
    "dev:api": "pnpm dev",
    "dev:worker": "pnpm exec tsx scripts/dev-worker.mts",
    "dev:web": "pnpm --filter @context-hub/web dev",
    "build": "tsc -p tsconfig.json && pnpm exec tsx scripts/fix-esm-imports.mts",
    "build:web": "pnpm --filter @context-hub/web build",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @context-hub/web typecheck",
    "test": "tsx --test src/**/*.test.ts",
    "migration:run": "NODE_OPTIONS='--import tsx' typeorm migration:run -d src/database/data-source.ts",
    "migration:revert": "NODE_OPTIONS='--import tsx' typeorm migration:revert -d src/database/data-source.ts",
    "migration:show": "NODE_OPTIONS='--import tsx' typeorm migration:show -d src/database/data-source.ts",
    "db:ping": "tsx src/database/check-connectivity.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhonathamatias/context-hub.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jhonathamatias/context-hub/issues"
  },
  "homepage": "https://github.com/jhonathamatias/context-hub#readme",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@google/generative-ai": "^0.24.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "bullmq": "^6.3.4",
    "fastify": "^5.12.3",
    "ioredis": "^5.11.1",
    "openai": "^7.10.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "typedi": "^0.10.0",
    "typeorm": "^1.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
