# Application
NODE_ENV=development
NODE_LOG_LEVEL=info
NODE_HOST=0.0.0.0
NODE_PORT=3000
# Aliases also accepted: HOST, PORT

# PostgreSQL (use DATABASE_URL or the DB_* parts)
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=context-hub
DB_HOST=db
DB_PORT=5432
# DATABASE_URL=postgresql://postgres:changeme@db:5432/context-hub

# Redis (use REDIS_URL or the REDIS_* parts)
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=redis://redis:6379

# Local processing directories
STORAGE_DIR=./storage
TEMP_DIR=./tmp

# Optional OpenAI (not required until LLM integration)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
