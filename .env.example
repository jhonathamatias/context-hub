# Application
NODE_ENV=development
NODE_LOG_LEVEL=info
NODE_HOST=0.0.0.0
NODE_PORT=3000
# Aliases also accepted: HOST, PORT

# PostgreSQL (use DATABASE_URL or the DB_* parts)
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=context-hub
DB_HOST=db
DB_PORT=5432
# DATABASE_URL=postgresql://postgres:changeme@db:5432/context-hub

# Redis (use REDIS_URL or the REDIS_* parts)
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=redis://redis:6379

# Local processing directories
STORAGE_DIR=./storage
TEMP_DIR=./tmp
MAX_UPLOAD_BYTES=524288000

# Local open-source Whisper (faster-whisper), not a paid API
WHISPER_PYTHON_PATH=/opt/whisper-venv/bin/python
WHISPER_SCRIPT_PATH=./python/transcribe.py
# tiny | base | small | medium | large-v3 | large-v3-turbo
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_TIMEOUT_MS=7200000
# Optional language (e.g. pt). Omit for auto-detect.
# WHISPER_LANGUAGE=pt
# Optional Whisper initial_prompt / glossary override.
# Default: built-in musical glossary. Set to "-" to disable.
# WHISPER_INITIAL_PROMPT=

# Knowledge LLM provider: openai | gemini | ollama
KNOWLEDGE_PROVIDER=gemini

# Central LLM (defaults to KNOWLEDGE_PROVIDER when omitted)
LLM_PROVIDER=gemini
# Recoverable failures (429/quota/timeout/5xx) fall back once to this provider
LLM_FALLBACK_PROVIDER=ollama
# Raise for local Ollama on CPU (e.g. 300000). Cloud Gemini usually finishes faster.
LLM_TIMEOUT_MS=300000
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=4096
# Concurrent MAP group LLM calls (keep low to reduce Gemini 429s)
LLM_CONCURRENCY=1

# Hierarchical knowledge MAP grouping
KNOWLEDGE_MAP_MAX_CHUNKS=15
KNOWLEDGE_MAP_MAX_CHARS=12000

# OpenAI (optional)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Gemini (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Ollama local fallback (docker compose service `ollama`)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
# Pull once (not during image build):
#   docker compose up -d ollama
#   docker compose exec ollama ollama pull qwen3:8b

# Embeddings: openai | gemini
EMBEDDING_PROVIDER=gemini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSION=
EMBEDDING_BATCH_SIZE=32

# Background jobs (BullMQ / Redis)
JOB_ATTEMPTS=3
JOB_CONCURRENCY=1
JOB_LOCK_DURATION_MS=7200000

# Optional: Microsoft Graph bearer token for private OneDrive/SharePoint shares
# Public "anyone with the link" shares work without this.
ONEDRIVE_ACCESS_TOKEN=
